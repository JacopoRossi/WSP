task_signatures = ["pay_val", "inv_chk", "ship_calc", "ord_conf", "cust_notif", "wh_alloc", "qc_chk", "final_proc"];


% Set up expanded tasks mapping

n_expanded = 21;  % 8 original tasks + 13 repetitions


original_task = [
  % For each task, list all its repetitions (original + additional)
  1,                % PAY_VAL (1 instance)
  2, 2, 2, 2,       % INV_CHK (original + 3 repetitions)
  3, 3, 3, 3,       % SHIP_CALC (original + 3 repetitions)
  4,                % ORD_CONF (1 instance)
  5, 5,       % CUST_NOTIF (original + 1 repetitions)
  6, 6, 6, 6,       % WH_ALLOC (original + 3 repetitions)
  7,                % QC_CHK (1 instance)
  8, 8, 8,       % FINAL_PROC (original + 3 repetitions)
  8                % FINAL_PROC
];


repetition_number = [
  0,                % PAY_VAL (original)
  0, 1, 2, 3,       % INV_CHK (original + reps)
  0, 1, 2, 3,       % SHIP_CALC (original + reps)
  0,                % ORD_CONF (original)
  0, 1,       % CUST_NOTIF (original + reps)
  0, 1, 2, 3,       % WH_ALLOC (original + reps)
  0,                % QC_CHK (original)
  0, 1, 2,       % FINAL_PROC (original + reps)
  3                % FINAL_PROC (original)
];


% Finish-to-start precedence constraints (id: 1 for PAY_VAL, 2 for INV_CHK, etc.)

n_pred = 0;
pred_from = [];
pred_to = [];
pred_wait_all = [];


% Start-to-start precedence constraints

