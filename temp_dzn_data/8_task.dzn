% Task Scheduling Data File with Services
% Generated from Enhanced DSL format
% Uses h_start and h_end time window instead of horizon
% Project: 8tasks


% Basic parameters

n_tasks = 8;

% Time window
h_start = 0;  % Planning window start time
h_end = 150;      % Planning window end time

max_resource = 110;


% Service information

n_services = 5;

service_names = ["Payment_Service", "Inventory_Service", "Order_Service", "Shipping_Service", "Notification_Service"];

task_to_service = [1, 2, 4, 3, 5, 2, 2, 3];  % Which service each task belongs to (0 = no service)

% Service composition:
% Service 1 (Payment_Service): Tasks [T1]
% Service 2 (Inventory_Service): Tasks [T2, T6, T7]
% Service 3 (Order_Service): Tasks [T4, T8]
% Service 4 (Shipping_Service): Tasks [T3]
% Service 5 (Notification_Service): Tasks [T5]


% Task properties

