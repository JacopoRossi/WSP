% Set up expanded tasks mapping

n_expanded = 18;  % 12 original tasks + 6 repetitions


original_task = [
  % For each task, list all its repetitions (original + additional)
  1,                % INIT_CORE (1 instance)
  2,                % COMM_PROTO (1 instance)
  3, 3, 3, 3,       % CTRL_EXEC (original + 3 repetitions)
  4, 4, 4, 4,       % SYNC_PROC (original + 3 repetitions)
  5,                % ANALYSIS_FULL (1 instance)
  6,                % VERIFY_QUICK (1 instance)
  7,                % PREPROCESS_SVC (1 instance)
  8,                % POSTPROCESS_SVC (1 instance)
  9,                % ORBIT_CTRL (1 instance)
  10,                % ORBIT_MGMT (1 instance)
  11,                % MONITOR_SYS (1 instance)
  12                % SAFE_DIR
];


repetition_number = [
  0,                % INIT_CORE (original)
  0,                % COMM_PROTO (original)
  0, 1, 2, 3,       % CTRL_EXEC (original + reps)
  0, 1, 2, 3,       % SYNC_PROC (original + reps)
  0,                % ANALYSIS_FULL (original)
  0,                % VERIFY_QUICK (original)
  0,                % PREPROCESS_SVC (original)
  0,                % POSTPROCESS_SVC (original)
  0,                % ORBIT_CTRL (original)
  0,                % ORBIT_MGMT (original)
  0,                % MONITOR_SYS (original)
  0                % SAFE_DIR (original)
];


% Finish-to-start precedence constraints (id: 1 for INIT_CORE, 2 for COMM_PROTO, etc.)

n_pred = 0;
pred_from = [];
pred_to = [];
pred_wait_all = [];


% Start-to-start precedence constraints

n_start_pred = 11;
start_pred_from = [1, 2, 1, 2, 3, 5, 6, 6, 6, 7, 1];
start_pred_to =   [3, 3, 5, 5, 4, 6, 7, 9, 10, 8, 11];
